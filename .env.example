# npm run dev / npm start use an existing external deployment; no local node.
# Save signer values privately in var/saigon.env; process environment overrides it.
CONFIG_PATH=var/saigon-v2-runtime.json
RPC_URL=https://saigon-testnet.roninchain.com/rpc
CHAIN_ID=202601
DEPLOYMENT_ID=saigon-v1
FINALITY=finalized
RELAYER_PRIVATE_KEY=
# Deploy requires distinct admin and operator wallets; never use a real-money wallet.
ADMIN_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
INITIAL_SUPPLY=1000000.000000
SUPPLY_CAP=10000000.000000
APP_ORIGIN=http://localhost:3300
PORT=3300
# Relayer gas top-up from the admin wallet (RELAYER_AUTO_FUND=0 disables it).
RELAYER_AUTO_FUND=1
RELAYER_MIN_RON=0.5
RELAYER_TOPUP_RON=2
ADMIN_MIN_RON=0.5
